#!/bin/bash
set -euo pipefail

# TEAM: Apple Developer team ID. Use a NOTARY_PROFILE stored by notarytool,
# or APPLE_ID and PASSWORD (app-specific password). NOTARY_TIMEOUT defaults to 20m.
if [ -z "${TEAM:-}" ]; then
    echo "set TEAM env var to your Apple Developer team ID" >&2
    exit 1
fi
if [ -n "${NOTARY_PROFILE:-}" ]; then
    NOTARY_AUTH=(--keychain-profile "$NOTARY_PROFILE")
elif [ -n "${APPLE_ID:-}" ] && [ -n "${PASSWORD:-}" ]; then
    NOTARY_AUTH=(--apple-id "$APPLE_ID" --password "$PASSWORD" --team-id "$TEAM")
else
    echo "set NOTARY_PROFILE, or APPLE_ID and PASSWORD env vars" >&2
    exit 1
fi

APPNAME=BLEUnlock
BASEDIR=$(cd -- "$(dirname -- "$0")" && pwd)
BUILDDIR="$BASEDIR/build"
RELEASEDIR="$BUILDDIR/Release"
RELEASE_TMPDIR="$BUILDDIR/release-tmp"
mkdir -p "$RELEASE_TMPDIR"

extract_info() {
    /usr/libexec/PlistBuddy -c "Print :$2" "$1/Contents/Info.plist"
}

notarize() {
    local app="$1"
    local label="$2"
    local upload="$RELEASE_TMPDIR/$label.zip"
    local result="$RELEASE_TMPDIR/$label.json"
    local status

    ditto -c -k --keepParent "$app" "$upload"
    if ! xcrun notarytool submit "$upload" "${NOTARY_AUTH[@]}" \
        --wait --timeout "${NOTARY_TIMEOUT:-20m}" --output-format json > "$result"; then
        echo "Notarization failed or timed out for $app; see $result" >&2
        return 1
    fi
    status=$(plutil -extract status raw -o - "$result")
    if [ "$status" != "Accepted" ]; then
        echo "Notarization rejected for $app: $status; see $result" >&2
        return 1
    fi
    xcrun stapler staple "$app"
}

xcodebuild \
    -project "$BASEDIR/BLEUnlock.xcodeproj" \
    -scheme "$APPNAME" \
    -configuration Release \
    -archivePath "$RELEASEDIR/$APPNAME.xcarchive" \
    CODE_SIGN_IDENTITY="Developer ID Application" \
    DEVELOPMENT_TEAM="$TEAM" \
    archive

xcodebuild \
    -exportArchive \
    -archivePath "$RELEASEDIR/$APPNAME.xcarchive" \
    -exportOptionsPlist "$BASEDIR/ExportOptions.plist" \
    -exportPath "$RELEASEDIR"

notarize "$RELEASEDIR/$APPNAME.app/Contents/Library/LoginItems/Launcher.app" launcher
notarize "$RELEASEDIR/$APPNAME.app" app

version=$(extract_info "$RELEASEDIR/$APPNAME.app" CFBundleShortVersionString)
ditto -c -k --keepParent "$RELEASEDIR/$APPNAME.app" "$RELEASEDIR/$APPNAME-$version.zip"

build=$(extract_info "$RELEASEDIR/$APPNAME.app" CFBundleVersion)
archive="$BASEDIR/archives/$version-$build"
mkdir -p "$archive"
cp -a "$RELEASEDIR/$APPNAME.xcarchive" "$archive/"
